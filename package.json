{
  "name": "cloudflare-modular-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/wrangler/bin/wrangler.js dev",
    "build:site": "node tools/build-site-assets.mjs",
    "build:cubecity": "npm --prefix vendor/cubecity run build -- --outDir ../../public/llrgamecubecity --emptyOutDir",
    "deploy": "npm run build:site && npm run build:cubecity && node ./node_modules/wrangler/bin/wrangler.js deploy",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "pretest": "npm run build:site",
    "test": "node --test tests/*.test.mjs",
    "types": "node ./node_modules/wrangler/bin/wrangler.js types --include-runtime false",
    "wrangler": "node ./node_modules/wrangler/bin/wrangler.js",
    "sync:kv:local": "node tools/import-local-kv.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "esbuild": "0.27.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.92.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
